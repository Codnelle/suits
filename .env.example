# Razorpay — home-visit fee and remote orders. Without these the checkout falls
# back to recording the request and confirming the amount by email.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Resend — where booking and order emails land. Without this, submissions fall
# back to a pre-filled mailto: link.
RESEND_API_KEY=
SHAHEE_INBOX=hello@shahee.in
SHAHEE_FROM=Shahee <onboarding@resend.dev>

# Anthropic — powers the cloth & fit assistant under the products on /order.
# Without it the assistant shows an "email us" note instead of answering.
ANTHROPIC_API_KEY=

# Master G's diary (/api/slots, shown on /tailor). Windows already promised
# elsewhere, comma separated: a whole day, a window, or either for one zone.
# e.g. SHAHEE_HELD=2026-12-03, 2026-12-04 15:00, east:2026-12-05 10:00
SHAHEE_HELD=

# Shahee CRM — Supabase project "shahee-crm". The secret key stays on the
# server; never expose it to the browser. Without these, bookings and orders
# still email, and /admin shows a setup note.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Password for /admin. ADMIN_SESSION_SECRET is optional: change it to sign
# everyone out without changing the password.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
