# Razorpay — home-visit fee and remote orders. Without these the checkout falls
# back to recording the request and confirming the amount by email.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Resend — where booking and order emails land. Without this, submissions fall
# back to a pre-filled mailto: link.
RESEND_API_KEY=
SHAHEE_INBOX=hello@shahee.in
SHAHEE_FROM=Shahee <onboarding@resend.dev>
